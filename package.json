{
  "name": "ethereum-tracker",
  "description": "Track and analyze Ethereum blockchain transactions in real-time.",
  "version": "1.0.0",
  "main": "./build/index.js",
  "scripts": {
    "start": "node ./build/index.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "start:dev": "npm run dev",
    "clean": "rimraf build",
    "build": "tsc",
    "build:image": "docker build -t ethereum-tracker .",
    "run:image": "docker run --init --env-file .env -p 3001:3000 ethereum-tracker",
    "docker-compose": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f",
    "eslint": "eslint src",
    "eslint:fix": "eslint src --fix",
    "prettify": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettify:check": "prettier --check \"**/*.+(js|ts|json)\"",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:create-migration": "typeorm migration:create src/database/migrations/InitialMigration",
    "typeorm:run-migrations": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "typeorm:revert-migrations": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "typeorm:run-migrations:prod": "typeorm migration:run -d build/database/data-source.js",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "api",
    "ethereum",
    "transactions",
    "tracker"
  ],
  "author": "Olusegun Ekoh (sheygs)",
  "repository": "https://github.com/sheygs/ethereum-tracker.git",
  "license": "MIT",
  "private": false,
  "dependencies": {
    "async-retry": "^1.3.3",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11 <12"
  },
  "type": "commonjs",
  "packageManager": "npm@11.10.1",
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
