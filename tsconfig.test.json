{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node20",
    "moduleResolution": "Node16",
    "types": ["node", "jest"],
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "build"]
}
